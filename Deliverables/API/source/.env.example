# ============================================================
# PC-Hospital-MD-Quantify — Hybrid Medical API
# Environment Variables Template
# Copiar como .env y llenar con valores reales
# ============================================================

# ---- Aplicación ----
APP_NAME="Quantify Medical API"
APP_VERSION="2.0.0"
APP_ENV="development"          # development | production
DEBUG=True
API_PREFIX="/api/v1"

# ---- Base de Datos MySQL (SQL) ----
DB_USER=root
DB_PASSWORD=tu_password_mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=quantify_medical_db
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40

# ---- Base de Datos MongoDB (NoSQL) ----
MONGO_URL=mongodb://localhost:27017
MONGO_DB=quantify_nosql
MONGO_LOGS_COLLECTION=logs_auditoria
MONGO_TELEMETRIA_COLLECTION=telemetria_sesion
MONGO_VALORACIONES_COLLECTION=valoraciones_flexibles

# ---- Seguridad JWT ----
SECRET_KEY=cambia_esto_por_una_clave_segura_de_al_menos_32_chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480    # 8 horas (turno médico completo)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- Rate Limiting ----
RATE_LIMIT_LOGIN=5/minute          # Máx intentos de login por IP
RATE_LIMIT_API=100/minute          # Máx requests generales por IP

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ---- Servidor ----
HOST=0.0.0.0
PORT=8000
WORKERS=4
